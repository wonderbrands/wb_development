<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="view_product_product_form_custom" model="ir.ui.view">
            <field name="name">product.product.form.custom.page</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Información adicional">
                    <group>
                        <field name="target_items" string="Venta objetivo"/>
                        <field name="purchase_active" string="Resurtible"/>
                        <field name="variant" string="Variante"/>
                    </group>
                </page>
            </notebook>
            </field>
        </record>
    </data>
    

</odoo>
