<odoo>
  <data>
    <record id="product_template_form_inherit_2" model="ir.ui.view">
      <field name="name">product.product.form.inherit.2</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_form_view"/>
      <field name="arch" type="xml">
        <xpath expr="//notebook" position="inside">
          <page string="Control SKUs">
            <group>
              <field name="security_stock"/>
              <field name="visualization_stock"/>
              <field name="pvp_aim"/>
              <field name="purchase_frequency"/>
              <field name="pc1" widget="percentage"/>
              <field name="pc2" widget="percentage"/>
              <field name="cluster"/>
              <field name="loading_qty_"/>
            </group>
          </page>
        </xpath>
      </field>
    </record>
  </data>
</odoo>