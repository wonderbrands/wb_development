<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="stock_picking_form_inherit" model="ir.ui.view">
            <field name="name">stock_picking_form_inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <xpath expr="//button[@name='action_assign']" position="attributes">
                        <attribute name="attrs">{
                            'invisible': ['|', 
                                          ('show_check_availability', '=', False), 
                                          ('restocked_field', '=', True)]
                        }</attribute>
                    </xpath>

                    <xpath expr="//button[@name='button_validate' and @class='oe_highlight']" position="attributes">
                        <attribute name="attrs">{
                            'invisible': ['|', 
                                          '|', 
                                          ('state', 'in', ('waiting', 'confirmed')), 
                                          ('show_validate', '=', False), 
                                          ('restocked_field', '=', True)]
                        }</attribute>
                    </xpath>

                    <xpath expr="//button[@name='button_validate' and @class='o_btn_validate']" position="attributes">
                        <attribute name="attrs">{
                            'invisible': ['|', 
                                          '|', 
                                          ('state', 'not in', ('waiting', 'confirmed')), 
                                          ('show_validate', '=', False), 
                                          ('restocked_field', '=', True)]
                        }</attribute>
                    </xpath>

                    <button name="reservation_from_superior_lvs"
                            type="object"
                            string="Reservación Fulfillment"
                            class="btn-primary"
                            attrs="{'invisible': ['!', '&amp;', 
                                                  ('state', 'in', ['waiting', 'confirm']), 
                                                  ('restocked_field', '=', True)]}" />
                </xpath>

                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="restocked_field" attrs="{'invisible': [('restocked_field', '=', False)]}" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
