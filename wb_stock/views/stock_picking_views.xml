<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="stock_picking_form_inherit" model="ir.ui.view">
            <field name="name">stock_picking_form_inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_assign']" position="attributes">
                    <attribute name="attrs">{'invisible': [('show_full_button', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="reservation_from_superior_lvs"
                            type="object"
                            string="Reservación Fulfillment"
                            class="btn-primary"
                            attrs="{'invisible': [('show_full_button', '=', False)]}" />
                </xpath>

                <xpath expr="//field[@name='origin']" position="after">
                    <field name="restocked_field" string="Es reserva para full" />
                </xpath>

                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="show_full_button" invisible="True"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
