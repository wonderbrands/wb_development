<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="wb_stock.prio_picking_form_inherit_custom" model="ir.ui.view">
        <field name="name">prio_picking_form_inherit_custom</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="wb_prio_picking.prio_picking_form_inherit"/>
        <field name="arch" type="xml">
              <xpath expr="//field[@name='origin']" position="after">
                <field name="restocked_field" string="Es reserva para full" />
            </xpath>
        </field>
    </record>
</odoo>
